# ===== ZORUNLU =====
# my.telegram.org -> "API development tools" -> uygulama olustur
TG_API_ID=1234567
TG_API_HASH=buraya_api_hash_yapistir
# Kanalin kullanici adi (@ ile) ya da t.me/... linki
TG_CHANNEL=@kanal_kullanici_adi

# ===== ISTEGE BAGLI =====
# Her sinyalde Telegram "Kayitli Mesajlar"a bildirim (1=acik 0=kapali)
BILDIRIM=1
# Her is gunu 20:10 NY (04:10 TR) gun sonu karnesi gonder
GUN_SONU_RAPORU=1
# Sanal hesap ve her isleme konacak oran (0.10 = %10)
SANAL_SERMAYE=10000
POZISYON_ORANI=0.10
